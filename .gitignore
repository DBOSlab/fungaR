# Default cache/output directories created by fungaR's own functions when run
# interactively from the package root (funga_download(), funga_records(),
# mycobank_gap(), mycobank_records(), distribution_gap(), spfungorum_gap(),
# spfungorum_records()), plus MycoBank's bulk export cache and refloraR's own
# download cache. These are local scratch data, never package content.
/funga_download/
/funga_records/
/mycobank_gap/
/mycobank_records/
/distribution_gap/
/spfungorum_gap/
/spfungorum_records/
/mycobank_download/
/reflora_download/

# testthat auto-saves the source of failing tests here for debugging; local
# debug clutter, never package content.
tests/testthat/_problems/
