Package: fungaR
Type: Package
Title: Tools for Accessing, Analyzing, and Curating Fungal Data from the Flora e Funga do Brasil Platform
Version: 1.0.0
Authors@R:
    c(
      person(given = "Domingos",
             family = "Cardoso",
             role = c("aut", "cre", "cph"),
